---

---

<section class="world-map-section" aria-labelledby="world-map-title">
  
        <div class="world-map-section-header">
          <h2 id="world-map-title" class="world-map-title">
            Visdeurbellers over de hele wereld
          </h2>

          <a href="#after-world-map" class="world-map-skip-button">Sla wereldkaart over</a>
        </div>

        <div class="world-map-section-layout">
          <aside
            class="world-map-section-countries"
            aria-labelledby="top-countries-title"
          >
            <h3 id="top-countries-title" class="top-countries-title">
              De meeste visdeurbellers in 2026 kwamen uit:
            </h3>

            <ol id="top-countries-list" class="top-countries-list"></ol>
            <div id="active-country-card" class="active-country-card">
              Selecteer een land om details te zien.
            </div>
          </aside>

          <div class="world-map-section-visual">
            <div class="world-map-legend" aria-hidden="true">
              <span>Minder bezoekers</span>
              <div class="world-map-legend-gradient"></div>
              <span>Meer bezoekers</span>
            </div>
            <div class="world-map-bubbles" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>
            <p id="world-map-country-total" class="world-map-country-total"></p>
            <svg
              id="world-map"
              class="world-map"
              role="img"
              aria-labelledby="world-map-title world-map-description"
            ></svg>

            <div
              id="world-map-tooltip"
              class="world-map-tooltip"
              role="status"
              aria-live="polite"
            ></div>
          </div>
        </div>
      </section>

<script>
    import "../styles/world-map.css";
    import "../js/charts/world-map.js";
</script>