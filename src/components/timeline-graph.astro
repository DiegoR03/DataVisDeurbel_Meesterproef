<section class="timeline-graph-section">
    <h2>Het beste tijdstip van het seizoen</h2>

    <p id="last-update">
        Laatste update: <span id="latest-date">Nog geen data geladen</span>
    </p>

    <div id="chart-container">
        <div id="html-legend">
            <h3>Filter op event / vis</h3>
            <div id="legend-items-container"></div>
        </div>
        <div id="chart"></div>
    </div>

    <div class="tooltip" id="tooltip"></div>
</section>

<script>
    import "../styles/timeline-graph.css";
    import { createGraph } from "../js/charts/timeline-graph.js";

    document.addEventListener("DOMContentLoaded", () => {
        const globalWindow = window as any;
        const rawData = globalWindow.SERVER_VIS_DATA || [];

        const data = rawData.map((item: any) => ({
            ...item,
            created_at: item.created_at ? new Date(item.created_at) : null,
        }));

        if (data.length > 0) {
            createGraph(data);
        }
    });
</script>
