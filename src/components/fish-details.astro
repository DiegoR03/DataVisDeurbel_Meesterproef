---
// @ts-nocheck
import "../styles/fish-facts.css";

const fishOptions = [
    { name: "Kolblei", img: "/img/kolblei.png" },
    { name: "Snoek", img: "/img/snoek.png" },
    { name: "Alver", img: "/img/alver.png" },
    { name: "Baars", img: "/img/baars.png" },
    { name: "Blankvoorn", img: "/img/blankvoorn.png" },
    { name: "Snoekbaars", img: "/img/snoekbaars.png" },
    { name: "Meerval", img: "/img/meerval.png" },
    { name: "Winde", img: "/img/winde.png" },
    { name: "Brasem", img: "/img/brasem.png" },
    { name: "Paling", img: "/img/paling.png" },
    { name: "Ruisvoorn", img: "/img/ruisvoorn.png" },
  ];

---
<section class="fish-facts-container" data-fish-options={JSON.stringify(fishOptions)}>
    <h2 class="title">Leer onze vissen kennen</h2>

    <div class="carousel-wrapper">
        <button class="carousel-btn prev-fish" type="button">&#10094;</button>
        
        <ul class="fish-cards-track">
            {fishOptions.map((fish) => {
                return (
                    <li class="fish-card" data-fish-name={fish.name}>
                        <div class="card-header">
                            <h3>{fish.name}</h3>
                            <span class="fish-size"></span>
                        </div>

                        <div class="card-photo-slider">
                            <button class="photo-btn prev-photo" type="button">&#10094;</button>
                            <div class="photo-frame">
                                <ul class="fish-photos-list">
                                    </ul>
                            </div>
                            <button class="photo-btn next-photo" type="button">&#10095;</button>
                        </div>

                        <p class="fish-active-time"></p>
                        <hr/>
                        <p class="fish-description"></p>
                    </li>
                )
            })}
        </ul>

        <button class="carousel-btn next-fish" type="button">&#10095;</button>
    </div>

    <div class="fish-image-modal">
        <button class="fish-image-close">X</button>
        <img class="fish-image-full" src="" alt="">
    </div>
</section>

<script src="../js/charts/picture-of-month.js"></script>