---
// @ts-nocheck
import "../styles/style.css";
import "../styles/intro-text.css";
import "../styles/picture-of-month.css";
import "../styles/fish-of-season.css";
import "../styles/timeline-graph.css";
import "../styles/world-map.css";
import "../styles/partial.css";
import "../styles/fish-facts.css";
import "../styles/fish-of-season.css";
import "../styles/average-time.css";

import Header from "../partials/header.astro";
import Footer from "../partials/footer.astro";

import * as d3 from "d3";

const NULL_VALUE = "\\N";

async function loadCsvData(csvUrl: any) {
  try {
    const baseUrl = Astro.url.origin;
    const response = await fetch(`${baseUrl}${csvUrl}`);
    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);

    const csvText = await response.text();
    const rawData = d3.csvParse(csvText);
    return rawData.map(formatDataObject);
  } catch (error) {
    console.error("Could not load CSV data server-side:", error);
    return [];
  }
}

function formatDataObject(dataObject: Record<string, any>) {
  const formattedObject: Record<string, any> = {};
  Object.entries(dataObject).forEach(([key, value]) => {
    formattedObject[key] = cleanValue(value);
  });

  formattedObject.created_at = dataObject.created_at || null;

  addFishData(formattedObject);
  return formattedObject;
}

function cleanValue(value: string | null) {
  if (!value || value === NULL_VALUE) return null;
  return value.trim();
}

function addFishData(dataObject: Record<string, any>) {
  const queryString = dataObject.url_query || dataObject.referrer_query;
  if (!queryString) {
    dataObject.fish_name = "Unknown";
    dataObject.snapshot_url = null;
    return;
  }
  const params = new URLSearchParams(queryString);
  dataObject.fish_name = params.get("fish") || "Unknown";
  const rawImageUrl = params.get("snapshotFishImageUrl");
  dataObject.snapshot_url = rawImageUrl
    ? decodeURIComponent(rawImageUrl)
    : null;
}

const CSV_URL = "/data/website_event-week.csv";

const visData = await loadCsvData(CSV_URL);

console.log((JSON.stringify(visData).length / 1024 / 1024).toFixed(2),"MB");
console.log("chicken nugget")
