---
// @ts-nocheck
import "../styles/style.css";
import MainAquarium from "../components/MainAquarium.astro";
 
import Header from "../partials/header.astro";
import Footer from "../partials/footer.astro";
import WorldMap from "../components/WorldMap.astro";
import IntroText from "../components/IntroText.astro";
import TimelineGraph from '../components/timeline-graph.astro';
import AverageFish from '../components/average-fish.astro';
import GuessTheFish from "../components/guess-the-fish.astro";
import FishFacts from "../components/fish-details.astro";
 
const NULL_VALUE = "\\N";
 
async function loadCsvData(csvUrl: any) {
  try {
    const baseUrl = Astro.url.origin;
    const response = await fetch(`${baseUrl}${csvUrl}`);
    if (!response.ok) throw new Error(`HTTP error! status: ${response.status}`);
 
    const csvText = await response.text();
    const rawData = parseCsv(csvText);
    return rawData.map(formatDataObject);
  } catch (error) {
    console.error("Could not load CSV data server-side:", error);
    return [];
  }
}
 
function parseCsv(csvText: string) {
  const lines = csvText.trim().split(/\r?\n/);
  if (lines.length === 0) return [];
 
  const headers = parseCsvLine(lines[0]);
  return lines.slice(1).map((line) => {
    const values = parseCsvLine(line);
    return headers.reduce((obj, key, index) => {
      obj[key] = values[index] ?? "";
      return obj;
    }, {} as Record<string, string>);
  });
}
 
function parseCsvLine(line: string) {
  const values: string[] = [];
  let current = "";
  let inQuotes = false;
 
  for (let i = 0; i < line.length; i++) {
    const char = line[i];
 
    if (char === '"') {
      if (inQuotes && line[i + 1] === '"') {
        current += '"';
        i++;
      } else {
        inQuotes = !inQuotes;
      }
    } else if (char === ',' && !inQuotes) {
      values.push(current);
      current = "";
    } else {
      current += char;
    }
  }
 
  values.push(current);
  return values;
}
 
function formatDataObject(dataObject: Record<string, any>) {
  const formattedObject: Record<string, any> = {};
  Object.entries(dataObject).forEach(([key, value]) => {
    formattedObject[key] = cleanValue(value);
  });
 
  formattedObject.created_at = dataObject.created_at || null;
 
  addFishData(formattedObject);
  return formattedObject;
}
 
function cleanValue(value: string | null) {
  if (!value || value === NULL_VALUE) return null;
  return value.trim();
}
 
function addFishData(dataObject: Record<string, any>) {
  const queryString = dataObject.url_query || dataObject.referrer_query;
  if (!queryString) {
    dataObject.fish_name = "Unknown";
    dataObject.snapshot_url = null;
    return;
  }
  const params = new URLSearchParams(queryString);
  dataObject.fish_name = params.get("fish") || "Unknown";
  const rawImageUrl = params.get("snapshotFishImageUrl");
  dataObject.snapshot_url = rawImageUrl
    ? decodeURIComponent(rawImageUrl)
    : null;
}
 
const CSV_URL = "/data/website_event-week.csv";
 
const visData = await loadCsvData(CSV_URL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/img/fih.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&display=swap"
      rel="stylesheet"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=PT+Sans:ital,wght@0,400;0,700;1,400;1,700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css"
    />

    <title>De visdeurbel visualisaties</title>
  </head>

  <body>
    <header>
      <Header />
    </header>

    <main>
      <IntroText />

      <WorldMap />

      <!-- grafiek 2 -->

      <MainAquarium />

      <AverageFish />

      <!-- grafiek 3 -->

      <TimelineGraph />

      <FishFacts />

      <GuessTheFish />



      <section>
        <p>Wat blub jij?</p>
        <h2>
          Deel je Visdeurbel momenten met de rest van de community. Stuur je
          foto, video, gedicht, lied, of bericht naar: visdeurbel@utrecht.nl
        </h2>
      </section>
    </main>

    <Footer />

    <!-- Met behulp van Gemini gefixed -->
    <script is:inline define:vars={{ visData }}>
      window.SERVER_VIS_DATA = visData;
    </script>

    <script>
      import "../js/index.js";
    </script>
  </body>
</html>
